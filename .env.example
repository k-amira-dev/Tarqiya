# Copy to .env and fill in. Never commit .env.
# Supabase → Connect → "Session pooler" string; start it with postgresql+psycopg:// and put the password in.
# Ask the team lead for it privately — never share it on GitHub or in chat groups.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
EMBEDDING_DIM=1536
EVIDENCE_DIR=./data/evidence
SESSION_HOURS=8
# Password given to the seeded test accounts
DEV_PASSWORD=promoflow-dev
# Appendix F pass mark: the form says 7/10, the policy says 80% (8/10). Open question.
SERVICE_PASS_POINTS=8
